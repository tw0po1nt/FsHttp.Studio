<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Run on the newest installed runtime at or above the target, so a user whose only SDK is a
         later LTS/STS (e.g. no .NET 10 runtime, only .NET 12) still launches the companion instead
         of hitting "You must install .NET 10.0". The activation-time floor check mirrors this. -->
    <RollForward>LatestMajor</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <!-- package.json sets the one version of both Clients and the companion. The companion sends it
       in `ready`. -->
  <PropertyGroup>
    <PackageJsonText>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../package.json'))</PackageJsonText>
    <PackageJsonVersion>$([System.Text.RegularExpressions.Regex]::Match($(PackageJsonText), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</PackageJsonVersion>
    <InformationalVersion>$(PackageJsonVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Envelope.fs" />
    <Compile Include="BlockLocator.fs" />
    <Compile Include="RequestCapture.fs" />
    <Compile Include="BlockRunner.fs" />
    <Compile Include="RequestHandler.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.204" />
    <PackageReference Include="FSharp.Core" Version="$(FSharpCoreVersion)" />
  </ItemGroup>

</Project>
