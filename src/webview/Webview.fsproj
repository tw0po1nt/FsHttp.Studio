<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Dom.fs" />
    <Compile Include="Main.fs" />
    <!-- The JS runtime smoke of the Renderer core. CI runs it under node at build time. Main.fs
         does not import it, so esbuild removes it from the webview bundle that ships. -->
    <Compile Include="Smoke.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="$(FSharpCoreVersion)" />
    <PackageReference Include="Fable.Core" Version="5.2.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.18.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../renderer/Renderer.fsproj" />
  </ItemGroup>

</Project>
