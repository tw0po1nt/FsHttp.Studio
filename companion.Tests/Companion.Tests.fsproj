<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Match the companion's assembly identity (ADR-0002's toolchain pin) so the two
         projects agree on one FSharp.Core. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="BlockLocatorTests.fs" />
    <Compile Include="TestServer.fs" />
    <Compile Include="BlockRunnerTests.fs" />
    <Compile Include="RequestHandlerTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.204" />
    <!-- Expecto is the idiomatic F# test framework; YoloDev.Expecto.TestSdk adapts it to
         the VSTest runner so `dotnet test` discovers the [<Tests>] suites unchanged. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Expecto" Version="11.1.0" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.16.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../companion/Companion.fsproj" />
  </ItemGroup>

</Project>
