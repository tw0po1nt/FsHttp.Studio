<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ProtocolTests.fs" />
    <Compile Include="RefusalsTests.fs" />
    <Compile Include="../GoldenFixture.fs" Link="GoldenFixture.fs" />
    <Compile Include="EnvelopeGoldenTests.fs" />
    <Compile Include="CursorRuleGoldenTests.fs" />
    <Compile Include="SdkFloorGoldenTests.fs" />
    <Compile Include="StatusTextGoldenTests.fs" />
    <Compile Include="CompileErrorTextGoldenTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="$(FSharpCoreVersion)" />
    <!-- Expecto over the VSTest adapter, matching companion.Tests / renderer.Tests so `dotnet
         test` discovers the [<Tests>] suites unchanged. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Expecto" Version="11.1.0" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.16.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/host/Extension.fsproj" />
    <!-- The envelope Golden fixtures contain the bytes of the companion's own encoder. -->
    <ProjectReference Include="../../src/companion/Companion.fsproj" />
  </ItemGroup>

</Project>
