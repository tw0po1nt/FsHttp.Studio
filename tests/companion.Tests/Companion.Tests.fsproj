<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="BlockLocatorTests.fs" />
    <Compile Include="PositionMatrixTests.fs" />
    <Compile Include="TestServer.fs" />
    <Compile Include="RequestCaptureTests.fs" />
    <Compile Include="BlockRunnerTests.fs" />
    <Compile Include="RequestHandlerTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The position-matrix corpora. `PositionMatrixTests` reads these from the source tree via
         `__SOURCE_DIRECTORY__`, so they need no copy-to-output. -->
    <None Include="fixtures\matrix.fsx" />
    <None Include="fixtures\extra.fsx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="$(FSharpCoreVersion)" />
    <!-- Expecto is the idiomatic F# test framework; YoloDev.Expecto.TestSdk adapts it to
         the VSTest runner so `dotnet test` discovers the [<Tests>] suites unchanged. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="Expecto" Version="11.1.0" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.16.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/companion/Companion.fsproj" />
  </ItemGroup>

</Project>
