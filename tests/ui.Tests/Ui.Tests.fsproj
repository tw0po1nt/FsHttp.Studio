<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\host\Refusals.fs" Link="Refusals.fs" />
    <Compile Include="Assert.fs" />
    <Compile Include="Proc.fs" />
    <Compile Include="Timing.fs" />
    <Compile Include="ExTester.fs" />
    <Compile Include="Harness.fs" />
    <Compile Include="Checks.fs" />
    <Compile Include="SelfCheckTests.fs" />
    <Compile Include="CorePathTests.fs" />
    <Compile Include="RequestSectionTests.fs" />
    <Compile Include="RunOutcomesTests.fs" />
    <Compile Include="LoopLensTests.fs" />
    <Compile Include="CrossBlockRefusedRunTests.fs" />
    <Compile Include="CompileErrorTests.fs" />
    <Compile Include="CompanionDeathTests.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.204" />
    <PackageReference Include="Fable.Core" Version="5.2.0" />
    <PackageReference Include="Fable.Mocha" Version="2.17.0" />
  </ItemGroup>

</Project>
