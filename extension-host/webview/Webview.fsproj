<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Agree with the renderer core on one FSharp.Core (ADR-0002's toolchain pin), so pulling it
         in as a project reference doesn't trip the NU1605 downgrade guard. -->
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Dom.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.204" />
    <PackageReference Include="Fable.Core" Version="5.2.0" />
    <PackageReference Include="Fable.Browser.Dom" Version="2.18.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../renderer/Renderer.fsproj" />
  </ItemGroup>

</Project>
