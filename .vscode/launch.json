{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension-host"
      ],
      "outFiles": [
        "${workspaceFolder}/extension-host/dist/**/*.js"
      ],
      "preLaunchTask": "build extension"
    }
  ]
}
