# Editors
.DS_Store
.idea/
*.iml
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
*.swp
*~

# .NET build output
bin/
obj/

# Node / build output
node_modules/
dist/
out/

# UI test harness — generated when the test HTTP server starts
tests/ui.Tests/fixtures/sidecar.json
*.vsix

# Env
.env
.env.*
!.env.example

# Local CLI state (e.g. gh device-id written when resolving GH_TOKEN on the host)
.local/

# Remote Control / worktree-isolated sessions
.claude/worktrees/

# Installed skills. scripts/bootstrap.sh restores both trees from skills-lock.json.
# The ASD-STE100 PDF in the simplified-technical-english skill stays local too,
# because ASD's terms do not permit redistribution.
.agents/skills/
.claude/skills/

# Feedback ledgers for a branch that has no PR yet. See docs/agents/feedback-ledger.md.
.scratch/

.fake
# Lua core suite: lazy.minit installs lazy.nvim, mini.test, and luassert here.
.tests/

# Neovim suite: generated when the test HTTP server starts
tests/nvim/fixtures/sidecar.json

# Neovim writes the help tags of the client here. The Neovim suite and lazy.nvim both run :helptags.
doc/tags
