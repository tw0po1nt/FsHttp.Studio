# What ships in the .vsix is the esbuild bundle under dist/, the icon, and the
# LICENSE / notices / README. Everything below is excluded. (vsce includes every
# file not matched here; patterns follow .gitignore semantics. The package root is
# the repo root, so this must also exclude the repo-infra dirs that live beside src/.)

# F#/Fable sources, projects, and tests — the shipped code is the bundled dist/extension.js
src/**
tests/**
**/*.fs
**/*.fsproj
**/*.fsx

# Fable intermediate JS (esbuild folds this into dist/)
out/**

# Build scripts, tooling, lockfiles, config
esbuild.mjs
smoke.mjs
package-lock.json
Directory.Build.props
global.json
FsHttp.Studio.slnx
.gitignore
.vscodeignore
.editorconfig

# Repo infrastructure — docs, CI, editor, agent tooling; none of it ships
docs/**
.github/**
.vscode/**
.config/**
.agents/**
.claude/**
scripts/**
AGENTS.md
CONTEXT.md
skills-lock.json

# Source maps and debug symbols — not needed at runtime
**/*.map
**/*.pdb

# Companion is framework-dependent and launched via `dotnet Companion.dll`
# (Companion.fs), so the native apphost launcher is never used.
dist/companion/Companion

# Icon SVG source — only the built PNG (package.json `icon`) is needed
media/*.svg

# README-only imagery. The Marketplace and GitHub render these from the repo
# (vsce rewrites relative image links to the repository), so they don't need to
# ship inside the .vsix — only media/icon.png (package.json `icon`) does.
media/hero.png
media/demo.gif

# Redundant with `vsce package --no-dependencies`, but explicit
node_modules/**
